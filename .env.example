# Local example only. Select SOMA_ENV explicitly in the process before startup.
SOMA_ENV=development
DJANGO_SECRET_KEY=local-only-soma-development-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TRUST_PROXY_SSL_HEADER=false
DJANGO_HSTS_SECONDS=0
# Required: setup prints an absolute OS-temp SQLite DATABASE_URL.
# No repository database or hosted target is supplied by this example.
DATABASE_URL=
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
SOMA_SENDER=console
# Offline-only account preview. Staging/production must remain disabled.
SOMA_ACCOUNT_EMAIL_MODE=disabled
