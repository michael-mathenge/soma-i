{
  "name": "somai-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner --host 127.0.0.1",
    "build": "vite build --configLoader runner && node scripts/report-gzip.js",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "test:e2e:guard": "node --test test-support/e2e-database-guard.test.js",
    "test:e2e:robustness": "node --test test-support/e2e-global-teardown.test.js test-support/python-resolution.test.mjs scripts/clean-e2e.test.mjs",
    "clean:e2e": "node scripts/clean-e2e.mjs",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.{js,jsx,json,css}\" \"tests/**/*.js\" \"*.{js,json,html}\""
  },
  "dependencies": {
    "axios": "1.20.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@eslint/js": "10.0.1",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "vite": "8.3.4"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": "12.11.2"
  }
}
