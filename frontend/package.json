{
  "name": "somai-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner --host 127.0.0.1",
    "build": "vite build --configLoader runner && node scripts/report-gzip.js",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.{js,jsx,json,css}\" \"tests/**/*.js\" \"*.{js,json,html}\""
  },
  "dependencies": {
    "axios": "^1.8.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@eslint/js": "^9.22.0",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "vite": "^6.2.6"
  }
}
