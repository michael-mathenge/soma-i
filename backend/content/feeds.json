        "beginner",
        "introduction",
        "intro",
        "getting started",
        "basics",
        "fundamentals",
        "handbook",
        "for beginners",
        "step by step"
      ],
      "strong_weight": 2,
      "medium_signals": ["how to", "tutorial", "guide", "what is"],
      "medium_weight": 1,
      "negative_signals": [
        "deep dive",
        "architecture",
        "enterprise",
        "production-ready",
        "internals",
        "from scratch",
        "agent",
        "llm",
        "rag",
        "tuning",
        "optimize",
        "trade-offs",
        "advanced",
        "pyspark",
        "algorithmic trading"
      ],
      "negative_weight": -2
    },
    "community_adjustment": -1,
    "recency_tiebreak": "published_at; fetched-date items have no recency advantage"
  },
  "exclusions": {
    "all": ["^\\s*Quiz:"],
    "community": [
      "\\bbest\\b.*\\bcompany\\b",
      "\\bfree\\b.*\\bapi\\b",
      "\\bbreaking my lurking streak\\b",
      "\\bintroduc(?:e|ing) myself\\b",
      "^\\s*(?:hi\\b|i[’']m\\b|i am\\b)"
    ]
  },
